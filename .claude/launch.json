{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_BACKEND_ORIGIN=http://localhost:8011 npm run dev -- --port 5175 --strictPort"
      ],
      "cwd": "web/frontend",
      "port": 5175
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PYTHONPATH=braccio_main_runner:. python -m uvicorn web.backend.app:app --port 8011"
      ],
      "port": 8011
    }
  ]
}
