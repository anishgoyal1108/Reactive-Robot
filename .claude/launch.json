{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5174"],
      "cwd": "web/frontend",
      "port": 5174
    },
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PYTHONPATH=braccio_main_runner:. python -m uvicorn web.backend.app:app --port 8000"
      ],
      "port": 8000
    }
  ]
}
